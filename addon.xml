<?xml version='1.0' encoding='UTF-8'?>
<addon id="repository.elarepo" name="ElaRepo Addon Repository" version="1.0.5" provider-name="elar3">
  <extension point="xbmc.addon.repository" name="ElaRepo Addon Repository">
    <!-- ElaRepo's own add-ons. Two copies of the same index: the GitHub distribution repository
         is listed first and is where downloads come from; repo.elarepo.org keeps serving the
         identical tree so that this repository ZIP can stay installable from the website and
         existing installs keep resolving. limniotis/elarepo mirrors the webroot path for path. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/limniotis/elarepo/main/zips/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/limniotis/elarepo/main/zips/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/limniotis/elarepo/main/zips/</datadir>
    </dir>
    <dir>
      <info compressed="false">https://repo.elarepo.org/zips/addons.xml</info>
      <checksum>https://repo.elarepo.org/zips/addons.xml.md5</checksum>
      <datadir zip="true">https://repo.elarepo.org/zips/</datadir>
    </dir>
    <!-- Twilight0's LIBS repository stays: IPARHO imports script.module.unicache, .parsers,
         .tulip, .netclient and .fuzzywuzzy from it. Twilight0's MAIN repository was removed
         with AliveGR - it carried only that add-on and its artwork. -->
    <dir>
      <info compressed="true">https://raw.githubusercontent.com/Twilight0/repository.twilight0.libs/master/repo_dir/addons.xml.gz</info>
      <checksum>https://raw.githubusercontent.com/Twilight0/repository.twilight0.libs/master/repo_dir/addons.xml.gz.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Twilight0/repository.twilight0.libs/master/repo_dir/</datadir>
      <hashes>false</hashes>
    </dir>
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/Gujal00/smrzips/master/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Gujal00/smrzips/master/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Gujal00/smrzips/master/zips/</datadir>
    </dir>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>Repository for various add-ons</summary>
    <description>Repository for various add-ons</description>
    <platform>all</platform>
    <news>1.0.5
- Downloads now come from the GitHub distribution repository; repo.elarepo.org is kept as a second copy
- AliveGR retired: Twilight0's main repository removed, libs repository kept for IPARHO's dependencies
1.0.4
- Add Twilight0 main and libs sources (AliveGR dependencies)
- Remove dead _zips directory and duplicate ElaRepo entry
    </news>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
